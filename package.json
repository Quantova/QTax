{
  "name": "@quantovainc/qtax",
  "version": "0.7.2",
  "description": "Post quantum tax integrity for governments. Seals tax filings, electronic invoices, assessments and refunds with ML-DSA-65 under FIPS 204 and Quantova time proofs, so an altered filing, an invented invoice or an unsupported refund is detected.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "qtax": "bin/qtax.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--require=$PWD/test/clock.js\" node --test test/*.test.js",
    "lint": "eslint ."
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "bin/",
    "wasm/qtax_native.js",
    "wasm/qtax_native_bg.wasm",
    "wasm/qtax_native.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "NOTICE",
    "AUTHORS"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@quantovainc/qstamp": "0.6.2"
  },
  "keywords": [
    "post-quantum",
    "quantum-safe",
    "tax",
    "e-invoicing",
    "vat",
    "anti-corruption",
    "government",
    "ml-dsa",
    "fips-204",
    "quantova"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Quantova Inc",
  "homepage": "https://github.com/Quantova/QTax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantova/QTax.git"
  },
  "bugs": {
    "url": "https://github.com/Quantova/QTax/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.1",
    "eslint-plugin-security": "3.0.1",
    "globals": "16.5.0"
  }
